# docker build -f docker\Dockerfile.api -t tep-api:dev .
# docker images tep-api

# The deployment gate runs npm ci/test/build before building this image.
# Standalone build: cd web && npm ci && npm run build, then build from root.
FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

COPY src ./src
COPY kafka ./kafka
COPY models ./models
COPY data/metadata ./data/metadata
COPY web/dist ./web/dist

ENV PYTHONPATH=/app

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=6 CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.getenv('API_PORT','8000')+'/health/ready',timeout=3)"

CMD ["python", "-m", "src.api.main"]
