# ============================================================
# Application
# ============================================================

APP_ENV=development
LOG_LEVEL=INFO


# ============================================================
# Kafka
# ============================================================

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

KAFKA_SENSOR_TOPIC=tep-sensor-data
KAFKA_PREDICTION_TOPIC=tep-predictions
KAFKA_DRIFT_TOPIC=tep-drift-events

KAFKA_CONSUMER_GROUP=inference-service


# ============================================================
# TEP Replay
# ============================================================

TEP_REPLAY_SPEED=1.0
TEP_REPLAY_INTERVAL_SECONDS=0.1


# ============================================================
# Inference
# ============================================================

MODEL_VERSION=v1.0.0
# 단일 행 추론·SHAP에 전체 CPU를 점유하지 않도록 스레드 수를 제한한다.
INFERENCE_THREADS=1
MODEL_DIR=models/production/v1.0.0
MODEL_ACTIVE_POINTER=logs/model-active.json

TEMPORAL_WARMUP_MINUTES=60

RISK_THRESHOLD_4H=0.622766
RISK_THRESHOLD_2H=0.610441
RISK_THRESHOLD_1H=0.783028


# ============================================================
# FastAPI
# ============================================================

API_HOST=0.0.0.0
API_PORT=8000
API_CONSUMER_GROUP=api-snapshots-v1
API_STORE_PATH=logs/api-snapshots.sqlite3
# Same-origin by default. Optional comma-separated development origins only.
API_ALLOWED_ORIGINS=


# ============================================================
# Monitoring / Drift
# ============================================================

DRIFT_CHECK_ENABLED=true
DRIFT_CHECK_INTERVAL_SECONDS=60
DRIFT_MIN_TIMESTAMP_HOURS=30
DRIFT_CONSUMER_GROUP=drift-monitor
DRIFT_REFERENCE_PATH=models/monitoring/drift-reference-v1.0.0.json
DRIFT_REFERENCE_VERSION=v1.0.0
# 검증된 train 기준 파일을 명시적으로 선택. 미지정 시 기존 통계 규칙을 사용한다.
# 파일을 선택하면 120개 창이 준비된 뒤 판정하고 RETRAIN_ENABLED=false가 필수다.
# train 검증이 완료된 운전상태 보정 기준을 사용한다. 자동 재학습은 계속 비활성이다.
DRIFT_CALIBRATION_PATH=models/monitoring/state-calibration-v1.0.0.json
DRIFT_RETRAINING_STATE_PATH=logs/retraining-state.json


# ============================================================
# Retraining
# ============================================================

# 현재 TEP 데이터에는 별도 운영 Drift label이 없어 자동 재학습은 기본 비활성화한다.
RETRAIN_ENABLED=false

CANDIDATE_MODEL_DIR=models/candidates
PRODUCTION_MODEL_DIR=models/production


# ============================================================
# Paths
# ============================================================

DATA_RAW_DIR=data/raw/TEP
DATA_PROCESSED_DIR=data/processed
DATA_METADATA_DIR=data/metadata

REPORT_DIR=reports
LOG_DIR=logs

# Unity 웹 빌드. 미지정 시 프로젝트의 정확한 에디터 버전을 사용한다.
UNITY_EDITOR_PATH=
# 낮은 버전은 원본을 바꾸지 않는 별도 프로젝트 빌드를 명시적으로 허용할 때만 사용한다.
UNITY_ALLOW_COMPATIBLE=false
